# Private bucket the desktop-shell release workflow uploads to.
# Same names as the GitHub Actions secrets. Nuxt also accepts the NUXT_ form:
# NUXT_S3_BUCKET, NUXT_AWS_REGION, NUXT_AWS_ACCESS_KEY_ID, NUXT_AWS_SECRET_ACCESS_KEY.
#
# The key needs s3:GetObject on arn:aws:s3:::<bucket>/releases/*
# Leave the access keys empty when the host provides an IAM role.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Defaults to releases, matching the workflow object keys:
#   releases/latest.json
#   releases/<version>/<file>
# S3_RELEASE_PREFIX=releases

# Stable links, once this site is deployed:
#   /download/windows
#   /download/mac
# Each one redirects to a presigned URL for the latest installer.
